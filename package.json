    "e2e:ceremony": "tsx --env-file=.env.local scripts/e2e/ceremony.ts",
    "voice": "tsx --env-file-if-exists=.env.local scripts/voice/generate.ts",
    "e2e:rehearsal": "tsx --env-file=.env.local scripts/e2e/rehearsal.ts",
    "localdb": "node scripts/localdb/server.mjs",
    "e2e:tennis-tv": "tsx --env-file=.env.localdb scripts/e2e/tennis-tv.ts",
