+  private func observeActivityUpdates() {
+    guard #available(iOS 16.2, *) else { return }
+    guard activityUpdatesObserverTask == nil else { return }
+    activityUpdatesObserverTask = Task { @MainActor [weak self] in
+      // Activities already running (for example started by push before the app launched)...
+      for activity in Activity<LiveActivityAttributes>.activities {
+        self?.observeActivityPushToken(activity)
+      }
+      // ...and every one that starts from now on, by the app or by push-to-start.
+      for await activity in Activity<LiveActivityAttributes>.activityUpdates {
+        self?.observeActivityPushToken(activity)
+      }
+    }
+  }
+
+  @available(iOS 16.2, *)
+  @MainActor
+  private func observeActivityPushToken(_ activity: Activity<LiveActivityAttributes>) {
+    let id = activity.id
+    guard activityTokenTasks[id] == nil else { return }
+    let url = activity.attributes.url
+    activityTokenTasks[id] = Task { @MainActor [weak self] in
+      if let data = activity.pushToken {
+        self?.sendActivityPushToken(id: id, token: data, url: url)
+      }
+      for await data in activity.pushTokenUpdates {
+        self?.sendActivityPushToken(id: id, token: data, url: url)
+      }
+      self?.activityTokenTasks[id] = nil
+    }
+  }
+
+  private func sendActivityPushToken(id: String, token: Data, url: String?) {
+    var payload: [String: Any] = [
+      "activityId": id,
+      "pushToken": token.reduce("") { $0 + String(format: "%02x", $1) }
+    ]
+    if let url {
+      payload["url"] = url
+    }
+    sendEvent(onActivityPushTokenReceived, payload)
+  }
+
+  private func stopObservingActivityUpdates() {
+    activityUpdatesObserverTask?.cancel()
+    activityUpdatesObserverTask = nil
+    let tasks = activityTokenTasks.values
+    activityTokenTasks.removeAll()
+    tasks.forEach { $0.cancel() }
+  }
+
   private var pushNotificationsEnabled: Bool {
     Bundle.main.object(forInfoDictionaryKey: pushNotificationsEnabledKey) as? Bool ?? false
   }
