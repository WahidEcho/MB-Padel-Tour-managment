+    // Move Score: a player's call to court counts down to its deadline on the lock screen
+    // (data.countdownUntil, epoch ms), and the notification goes away when the call ends.
+    val countdownUntil = content.body?.optLong("countdownUntil", 0L) ?: 0L
+    val countdownLeft = countdownUntil - System.currentTimeMillis()
+    if (countdownLeft > 1_000L) {
+      builder.setWhen(countdownUntil)
+      builder.setShowWhen(true)
+      builder.setUsesChronometer(true)
+      builder.setChronometerCountDown(true)
+      builder.setTimeoutAfter(countdownLeft)
+      // Alarm category: Do Not Disturb lets it through when alarms are allowed (the default).
+      builder.setCategory(NotificationCompat.CATEGORY_ALARM)
+      builder.setVisibility(NotificationCompat.VISIBILITY_PUBLIC)
+    }
