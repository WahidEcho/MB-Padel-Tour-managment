# Supabase (server-side only — never expose these to the browser)
SUPABASE_URL=
SUPABASE_KEY=

# Session signing secret (random 64-char hex)
AUTH_SECRET=

# Organisation staff sessions (personal accounts and event codes): signs the
# `mbs1.` staff cookie/token. Random, 32+ characters (e.g. `openssl rand -hex 32`).
# Required in production: without it no organiser or event-code session works.
STAFF_SESSION_SECRET=

# Keys the stored hashes of event codes (HMAC). Random, 32+ characters, never in the
# database. Required in production: without it event codes can be neither issued nor
# used (shared passwords and personal accounts still work). Changing it voids every code.
EVENT_CODE_PEPPER=

# Keys player-code hashes and seals, phone one-time-code hashes and the email hashes of
# organiser link offers (src/lib/players/codeVault.ts). Random, 32+ characters, never in
# the database, NOT the same value as EVENT_CODE_PEPPER. Required in production: without
# it player codes and phone codes cannot be checked (sign-in answers "not available").
# Changing it voids every player code (reset them all). docs/player-identity.md.
PLAYER_CODE_PEPPER=

# Shared role passwords (Move Beyond organisation only; retired at the end of Phase 0.5)
ADMIN_PASSWORD=
MANAGER_PASSWORD=
REFEREE_PASSWORD=
OPERATOR_PASSWORD=

# Move Score app (all optional until the feature is switched on)
CRON_SECRET=                # protects /api/internal/notifications/drain
EXPO_ACCESS_TOKEN=          # Expo push "enhanced security" token
VENUE_QR_SECRET=            # signs the gate code (falls back to AUTH_SECRET)
# Sign in with Apple (account deletion revokes the Apple token)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIGNIN_KEY_P8=
APPLE_CLIENT_ID=            # the app's bundle id
# iPhone lock-screen live scores (direct Apple push)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=               # 1 for development builds
# Apple Wallet pass. Each value: PEM (newlines or \n), or base64 of the .cer/.pem/.key file,
# or base64 of the Keychain .p12 (`base64 -i Certificates.p12`) in CERT and/or KEY.
# Pass type + team are read from the certificate. Check: GET /api/health/wallet
APPLE_PASS_TYPE_ID=          # optional; the certificate's UID wins
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=   # the key's or the .p12's password
APPLE_WWDR_CERT=             # optional; Apple WWDR G4 is bundled
# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
# WhatsApp phone codes (docs/messaging.md, "mb_login_code"): the approved AUTHENTICATION
# template's name and language. Unset: codes go by email only, after the player agrees.
WA_OTP_TEMPLATE=
WA_OTP_TEMPLATE_LANG=       # default en
# Registration payments (Move Beyond's events only). Directly through XPay (docs/xpay-direct.md), or
# through Move Tick's partner API (docs/move-tick-partner-api.md). Neither configured: fees are paid at the venue.
PAYMENT_PROVIDER=           # xpay | move_tick (default: xpay when XPAY_SECRET_KEY is set, else move_tick if configured)
XPAY_SECRET_KEY=            # sk_test_… / sk_live_… (the same XPay account and key as Move Tick); the prefix is the mode
XPAY_WEBHOOK_SECRET=        # the signing secret of Move Score's OWN endpoint in the XPay dashboard (/api/webhooks/xpay)
XPAY_PAYMENT_METHOD_TYPES=  # optional, e.g. card,valu (each must be enabled on the XPay account); unset: the account's defaults
XPAY_API_BASE=              # optional, default https://api.xpay.app (http://localhost:… only for the stand-in's fake XPay)
# Move Tick partner API (PAYMENT_PROVIDER=move_tick): all three or none.
MOVE_TICK_API_URL=          # https://move-tick.mbeg.org
MOVE_TICK_PARTNER_KEY=      # the bearer key Move Tick issued to Move Score (32+ characters)
MOVE_TICK_WEBHOOK_SECRET=   # signs Move Tick's webhooks to /api/webhooks/move-tick (32+ characters)
MOVE_TICK_MODE=             # live | test (default: live in production). Must match Move Tick's XPay key mode.
