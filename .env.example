# Supabase (server-side only — never expose these to the browser)
SUPABASE_URL=
SUPABASE_KEY=

# Session signing secret (random 64-char hex)
AUTH_SECRET=

# Shared role passwords
ADMIN_PASSWORD=
MANAGER_PASSWORD=
REFEREE_PASSWORD=
OPERATOR_PASSWORD=

# Move Score app (all optional until the feature is switched on)
CRON_SECRET=                # protects /api/internal/notifications/drain
EXPO_ACCESS_TOKEN=          # Expo push "enhanced security" token
VENUE_QR_SECRET=            # signs the gate code (falls back to AUTH_SECRET)
# Sign in with Apple (account deletion revokes the Apple token)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SIGNIN_KEY_P8=
APPLE_CLIENT_ID=            # the app's bundle id
# iPhone lock-screen live scores (direct Apple push)
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=               # 1 for development builds
# Apple Wallet pass (PEM, \n for newlines)
APPLE_PASS_TYPE_ID=
APPLE_PASS_CERT=
APPLE_PASS_KEY=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_CERT=
# Google Wallet
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_KEY=
