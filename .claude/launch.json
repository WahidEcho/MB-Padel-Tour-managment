{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "url": "http://localhost:3001",
      "port": 3001
    },
    {
      "name": "move-score-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8099"
      ],
      "cwd": "move-score-app",
      "port": 8099,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3077"
      }
    },
    {
      "name": "localdb",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "localdb"
      ],
      "port": 54321
    },
    {
      "name": "move-score-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.localdb; set +a; exec npx next dev -p 3077"
      ],
      "port": 3077
    },
    {
      "name": "registration-server",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.localdb; set +a; PUBLIC_SITE_URL=http://localhost:3077 PUSH_DRY_RUN=1 MESSAGING_DRY_RUN=1 exec npx next start -p 3077"
      ],
      "port": 3077
    },
    {
      "name": "fake-move-tick",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "--env-file=.env.localdb",
        "scripts/demo/fake-move-tick.ts"
      ],
      "port": 54399
    },
    {
      "name": "dev-localdb",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.localdb; set +a; PUSH_DRY_RUN=1 MESSAGING_DRY_RUN=1 exec npx next dev -p 3078"
      ],
      "port": 3078
    }
  ]
}
