{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "url": "http://localhost:3001",
      "port": 3001
    },
    {
      "name": "move-score-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8099"
      ],
      "cwd": "move-score-app",
      "port": 8099,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "http://localhost:3077",
        "CI": "1"
      }
    }
  ]
}